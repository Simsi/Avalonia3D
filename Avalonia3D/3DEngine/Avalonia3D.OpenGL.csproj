<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>ThreeDEngine</RootNamespace>
    <AssemblyName>Avalonia3D.OpenGL</AssemblyName>
    <PackageId>Avalonia3D.OpenGL</PackageId>
    <Description>Desktop OpenGL renderer and Avalonia presenter for Avalonia3D.</Description>
    <IsPackable>true</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="OpenGL/**/*.cs" />
    <ProjectReference Include="Avalonia3D.Core.csproj" />
    <ProjectReference Include="Avalonia3D.Avalonia.csproj" />
    <PackageReference Include="Avalonia" />
  </ItemGroup>
</Project>
